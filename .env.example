# Форма обратной связи (src/app/api/contact/route.ts).
# Скопировать в .env.local для локальной разработки и завести те же
# переменные на Vercel → Settings → Environment Variables.

# Куда падают заявки. Можно не задавать — по умолчанию info@axisarredi.it.
CONTACT_TO=info@axisarredi.it

# От чьего имени уходит письмо.
#  · Zoho SMTP — адрес обязан совпадать с логином ящика или его алиасом,
#    иначе Zoho отклонит письмо: "Axis Arredi <info@axisarredi.it>".
#  · Resend — адрес на подтверждённом домене: "Axis Arredi <sito@send.axisarredi.it>".
CONTACT_FROM="Axis Arredi <info@axisarredi.it>"

# ── Вариант 1: Zoho SMTP (nodemailer) ────────────────────────────────
# Работает только на платных тарифах Zoho: на Forever Free доступ по
# IMAP/POP/SMTP отключён. Хост зависит от региона аккаунта: smtp.zoho.eu
# (ЕС), smtp.zoho.com (США), smtp.zoho.in (Индия) — регион виден по адресу
# панели Zoho. Пароль — App Password из Zoho Accounts → Security.
# SMTP_HOST=smtp.zoho.eu
# SMTP_PORT=465
# SMTP_USER=info@axisarredi.it
# SMTP_PASS=app-password-из-zoho
# Необязательно: по умолчанию true для порта 465 и false для остальных.
# SMTP_SECURE=true

# ── Вариант 2: Resend (приоритетный — если ключ задан, SMTP не трогается) ──
# resend.com → API Keys. Домен подтверждается в разделе Domains; берите
# поддомен send.axisarredi.it, чтобы SPF/DKIM не конфликтовали с записями
# Zoho на корне домена.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
